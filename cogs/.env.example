# Copiez ce fichier vers .env puis renseignez les valeurs. Ne commitez jamais .env.
DISCORD_TOKEN=
# Optionnel : ID du serveur pour synchroniser les commandes instantanément en développement.
DISCORD_GUILD_ID=
# Mettre à true une seule fois pour une première synchronisation globale, puis remettre à false.
SYNC_GLOBAL_COMMANDS=false

# Riot Developer API key used to validate Riot IDs (never commit your real .env)
RIOT_API_KEY=
